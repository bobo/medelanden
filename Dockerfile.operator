FROM golang:1.24-alpine AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /medelanden-operator ./cmd/operator

FROM gcr.io/distroless/static:nonroot
COPY --from=builder /medelanden-operator /medelanden-operator
USER 65532:65532
ENTRYPOINT ["/medelanden-operator"]
